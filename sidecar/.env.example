# SAM3 sidecar
# Backend is selected by the launcher:
#   .\run.ps1 / ./run.sh          → transformers (facebook/sam3 Tracker)
#   .\run.ps1 --mock / ./run.sh --mock → mock
# PORT=9001
PORT=9001

# Gated HF weights — accept the license at https://huggingface.co/facebook/sam3
# then paste a token with read access:
# HF_TOKEN=hf_xxx

# Optional override (default facebook/sam3):
# SAM3_MODEL_ID=facebook/sam3

# Mask leak cleanup (default on): open thin bridges, keep largest connected component
# SAM3_MASK_CLEANUP=1
# SAM3_MASK_OPEN_K=5
